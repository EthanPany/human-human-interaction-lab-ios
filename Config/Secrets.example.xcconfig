// Copy to Secrets.xcconfig (gitignored) and fill in.
// xcconfig treats "//" as a comment, so URLs are written as https:/$()/host

// From backend/.env.local after `npx convex dev`
CONVEX_URL = https:/$()/your-deployment.convex.cloud

// SpacetimeDB variant (spacetime/ in the parent repo). Optional; Settings can set these too.
// BACKEND_PROVIDER = spacetime makes it the default instead of Convex.
BACKEND_PROVIDER = convex
SPACETIME_HOST = https:/$()/maincloud.spacetimedb.com
SPACETIME_DB = your-database

// The agent's iMessage number from Photon (used by "Text your agent")
AGENT_PHONE = +15555550123

// Xcode > Settings > Accounts > your team ID
DEVELOPMENT_TEAM = ABCDE12345
